#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:781
#, php-format
msgid "<strong>%s Pro is on.</strong> Thank you! Every Pro tool is switched on for this site, and updates come to your dashboard."
msgstr "<strong>%s Pro مُفعّل.</strong> شكرًا لك! كل أدوات Pro تعمل على هذا الموقع، والتحديثات تصل إلى لوحة التحكم."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:830
#, php-format
msgid "<strong>%s Pro is installed, but no Pro license is active on this site.</strong> Enter your license key to switch on the Pro tools."
msgstr "<strong>%s Pro مثبّت، لكن لا يوجد ترخيص Pro نشط على هذا الموقع.</strong> أدخل مفتاح الترخيص لتشغيل أدوات Pro."

#: pro/licensorpro-client/licensorpro-client.php:836
msgid "Enter license key"
msgstr "أدخل مفتاح الترخيص"

#: pro/licensorpro-client/licensorpro-client.php:839
msgid "Find your key in your account"
msgstr "تجد المفتاح في حسابك"

#: pro/licensorpro-client/licensorpro-client.php:865
msgid "Renew your license"
msgstr "جدّد ترخيصك"

#. translators: 1: plugin name, 2: expiry date, 3: lock date, 4: days left
#: pro/licensorpro-client/licensorpro-client.php:871
#, php-format
msgid "<strong>Your %1$s Pro license expired on %2$s.</strong> Pro keeps working as normal until %3$s (%4$d days left). Updates, including security fixes, and email support have stopped. After %3$s, everything you already set up keeps working and your visitors won't notice a thing, but the Pro tools in your dashboard will lock."
msgstr "<strong>انتهى ترخيص %1$s Pro في %2$s.</strong> يستمر Pro بالعمل كالمعتاد حتى %3$s (بقي %4$d يومًا). توقفت التحديثات، ومنها إصلاحات الأمان، وتوقف الدعم عبر البريد الإلكتروني. بعد %3$s يبقى كل ما أعددته يعمل ولن يلاحظ زوارك أي شيء، لكن أدوات Pro في لوحة التحكم ستُقفل."

#. translators: 1: plugin name, 2: expiry date
#: pro/licensorpro-client/licensorpro-client.php:881
#, php-format
msgid "<strong>%1$s Pro tools are locked because your license expired on %2$s.</strong> Your site, and everything visitors see, still works. Renew to unlock the Pro tools and get updates, including security fixes, again."
msgstr "<strong>أدوات %1$s Pro مقفلة لأن ترخيصك انتهى في %2$s.</strong> موقعك وكل ما يراه الزوار ما زال يعمل. جدّد الترخيص لفتح أدوات Pro والحصول على التحديثات مجددًا، ومنها إصلاحات الأمان."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:889
#, php-format
msgid "<strong>This site is no longer activated on your %s Pro license.</strong> The Pro tools in your dashboard are locked until you activate it again. Everything visitors see keeps working."
msgstr "<strong>هذا الموقع لم يعد مُفعّلًا على ترخيص %s Pro.</strong> أدوات Pro في لوحة التحكم مقفلة حتى تفعّله مجددًا. كل ما يراه الزوار يستمر بالعمل."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:896
#, php-format
msgid "<strong>Your %s Pro license is no longer active.</strong> It was refunded or cancelled, so the Pro tools in your dashboard are locked and updates have stopped. Everything visitors see keeps working."
msgstr "<strong>ترخيص %s Pro لم يعد نشطًا.</strong> تم استرداد المبلغ أو إلغاء الاشتراك، لذا أُقفلت أدوات Pro في لوحة التحكم وتوقفت التحديثات. كل ما يراه الزوار يستمر بالعمل."

#: pro/licensorpro-client/licensorpro-client.php:998
msgid "Please enter a license key."
msgstr "الرجاء إدخال مفتاح ترخيص."

#: pro/licensorpro-client/licensorpro-client.php:1010
#: pro/licensorpro-client/licensorpro-client.php:1069
msgid "License response failed signature verification."
msgstr "فشل التحقق من توقيع رد الترخيص."

#: pro/licensorpro-client/licensorpro-client.php:1052
msgid "No license key set."
msgstr "لم يتم تعيين مفتاح ترخيص."

#: pro/licensorpro-client/licensorpro-client.php:1184
msgid "Only deactivating temporarily"
msgstr "أعطّلها مؤقتًا فقط"

#: pro/licensorpro-client/licensorpro-client.php:1185
msgid "I could not work out how to use it"
msgstr "لم أعرف كيف أستخدمها"

#: pro/licensorpro-client/licensorpro-client.php:1186
msgid "It is missing a feature I need"
msgstr "تنقصها ميزة أحتاجها"

#: pro/licensorpro-client/licensorpro-client.php:1187
msgid "It did not work"
msgstr "لم تعمل"

#: pro/licensorpro-client/licensorpro-client.php:1188
msgid "It broke something on my site"
msgstr "تسببت في عطل في موقعي"

#: pro/licensorpro-client/licensorpro-client.php:1189
msgid "I found a better plugin"
msgstr "وجدت إضافة أفضل"

#: pro/licensorpro-client/licensorpro-client.php:1190
msgid "I no longer need it"
msgstr "لم أعد بحاجة إليها"

#: pro/licensorpro-client/licensorpro-client.php:1191
msgid "Something else"
msgstr "سبب آخر"

#. translators: %s: plugin name.
#: pro/licensorpro-client/licensorpro-client.php:1218
#, php-format
msgid "Before you turn %s off"
msgstr "قبل أن تعطّل %s"

#: pro/licensorpro-client/licensorpro-client.php:1222
msgid "If you have a moment, what went wrong? It is the only way we hear about it."
msgstr "إن كان لديك دقيقة، ما الذي لم يعمل؟ هذه هي الطريقة الوحيدة لنعرف بذلك."

#: pro/licensorpro-client/licensorpro-client.php:1233
msgid "Anything else? (optional)"
msgstr "هل من شيء آخر؟ (اختياري)"

#: pro/licensorpro-client/licensorpro-client.php:1235
msgid "Sends your answer, the plugin version and your site address. Nothing else, and nothing from your site content."
msgstr "يُرسل إجابتك وإصدار الإضافة وعنوان موقعك. لا شيء غير ذلك، ولا شيء من محتوى موقعك."

#: pro/licensorpro-client/licensorpro-client.php:1239
msgid "Send and deactivate"
msgstr "أرسل وعطّل"

#: pro/licensorpro-client/licensorpro-client.php:1242
msgid "Skip and deactivate"
msgstr "تخطَّ وعطّل"

#: pro/licensorpro-client/licensorpro-client.php:1245
#: admin/assets/js/admin.js:510
msgid "Cancel"
msgstr "إلغاء"

