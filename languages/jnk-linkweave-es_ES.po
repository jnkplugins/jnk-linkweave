msgstr "Tarjetas opcionales al pasar el ratón, con título, imagen y extracto, en los enlaces internos."

#: admin/views/upgrade.php:43
msgid "CSV export"
msgstr "Exportación CSV"

#: admin/views/upgrade.php:43
msgid "Export the orphan-page and anchor-text reports to CSV."
msgstr "Exporta a CSV los informes de páginas huérfanas y de texto ancla."

#: admin/views/upgrade.php:44
msgid "Cross-site linking"
msgstr "Enlazado entre sitios"

#: admin/views/upgrade.php:44
msgid "Suggest links between the sites on your license, right in the editor. Works on every plan."
msgstr "Sugiere enlaces entre los sitios de tu licencia, directamente en el editor. Funciona en todos los planes."

#: admin/views/upgrade.php:45
