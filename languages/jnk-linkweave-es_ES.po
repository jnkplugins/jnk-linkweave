#. Plugin Name of the plugin
#: jnk-linkweave.php
#: editor/src/index.js:20
#: editor/src/index.js:24
msgid "JnK Linkweave"
msgstr "JnK Linkweave"

#. Plugin URI of the plugin
#: jnk-linkweave.php
msgid "https://jnkplugins.com/jnk-linkweave/"
msgstr "https://jnkplugins.com/jnk-linkweave/"

#. Description of the plugin
#: jnk-linkweave.php
msgid "Affordable, server-side internal linking for WordPress — suggestions, auto-linking rules, and orphan &amp; broken-link reports."
msgstr "Enlazado interno asequible y en el servidor para WordPress: sugerencias, reglas de enlace automático e informes de páginas huérfanas y enlaces rotos."

#. Author of the plugin
#: jnk-linkweave.php
msgid "JnK Plugins"
msgstr "JnK Plugins"

#. Author URI of the plugin
#: jnk-linkweave.php
msgid "https://jnkplugins.com"
msgstr "https://jnkplugins.com"

#: admin/class-admin.php:41
msgid "JnK Linkweave could not create its database tables."
msgstr "JnK Linkweave no pudo crear sus tablas en la base de datos."

#: admin/class-admin.php:42
msgid "Link suggestions and the reports need them. Send the details below to support (jnkplugins.com/contact) and we will sort it out with you."
msgstr "Las sugerencias de enlaces y los informes las necesitan. Envía los detalles de abajo al soporte (jnkplugins.com/contact) y lo resolvemos contigo."

#: admin/class-admin.php:85
msgid "This is JnK Linkweave Pro, but no license is active on this site, so the Pro features are switched off: the URL Changer, link click analytics, Search Console targeting, the auto-link map, the Anchor Text and Links per post reports, broken-link repair, related posts, link preview cards, bulk link insertion, the link check before you publish, extra rule options, cross-site linking, AI re-ranking, AI assistant access and the CSV exports."
msgstr "Esto es JnK Linkweave Pro, pero no hay ninguna licencia activa en este sitio, así que las funciones Pro están desactivadas: el cambiador de URL, las estadísticas de clics en enlaces, la segmentación con Search Console, el mapa de enlaces automáticos, los informes de texto de anclaje y de enlaces por entrada, la reparación de enlaces rotos, las entradas relacionadas, las tarjetas de vista previa, la inserción de enlaces en bloque, la revisión de enlaces antes de publicar, las opciones extra de las reglas, los enlaces entre sitios, la reordenación con IA, el acceso para asistentes de IA y las exportaciones CSV."

