msgstr "Rompió algo en mi sitio"

#: pro/licensorpro-client/licensorpro-client.php:1189
msgid "I found a better plugin"
msgstr "Encontré un plugin mejor"

#: pro/licensorpro-client/licensorpro-client.php:1190
