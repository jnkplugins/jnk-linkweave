#: admin/views/rules.php:26
#, php-format
msgid "Need to change a URL across every post at once, with one-click undo? %1$sSee what Pro adds%2$s."
msgstr "¿Necesitas cambiar una URL en todas las entradas a la vez, y poder deshacerlo con un clic? %1$sMira lo que añade Pro%2$s."

