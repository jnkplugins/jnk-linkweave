#: pro/licensorpro-client/licensorpro-client.php:1849
msgid "Deactivate this site"
msgstr "Desactivar este sitio"

#: pro/licensorpro-client/licensorpro-client.php:1856
msgid "This is the free version, running on your Pro license."
msgstr "Esta es la versión gratuita, funcionando con tu licencia Pro."

#: pro/licensorpro-client/licensorpro-client.php:1873
msgid "Have a Pro license key? Enter it here to switch on the Pro tools. It replaces the free license on this site."
msgstr "¿Tienes una clave de licencia Pro? Introdúcela aquí para activar las herramientas Pro. Sustituye a la licencia gratuita en este sitio."

#: pro/licensorpro-client/licensorpro-client.php:1874
msgid "Enter your license key to activate this site."
msgstr "Introduce tu clave de licencia para activar este sitio."

#: pro/licensorpro-client/licensorpro-client.php:1881
msgid "Activate"
msgstr "Activar"

#: pro/licensorpro-client/licensorpro-client.php:1884
msgid "Your key is in your purchase email and in your account."
msgstr "Tu clave está en el correo de tu compra y en tu cuenta."

#: pro/licensorpro-client/licensorpro-client.php:1892
msgid "Need a hand?"
msgstr "¿Necesitas ayuda?"

#: pro/licensorpro-client/licensorpro-client.php:1893
msgid "Contact support"
msgstr "Contactar con soporte"

#: pro/licensorpro-client/licensorpro-client.php:1900
msgid "Every seat on this license is in use. Deactivate one of your other sites from your account, then try again."
msgstr "Todos los sitios de esta licencia están en uso. Desactiva uno de tus otros sitios desde tu cuenta y vuelve a intentarlo."

#: pro/licensorpro-client/licensorpro-client.php:1901
msgid "This license has expired. Renewing it from your account reactivates this site immediately. Your settings and data are untouched."
msgstr "Esta licencia ha caducado. Al renovarla desde tu cuenta, este sitio se reactiva al momento. Tus ajustes y datos no se tocan."

#: pro/licensorpro-client/licensorpro-client.php:1902
msgid "That key was not recognised. Check for a missing character, or copy it again from your purchase email."
msgstr "No reconocemos esa clave. Comprueba que no falte ningún carácter o vuelve a copiarla del correo de tu compra."

#: pro/licensorpro-client/licensorpro-client.php:1903
msgid "This key has been revoked. If you believe that is a mistake, reply to your purchase email and we will sort it out."
msgstr "Esta clave se ha revocado. Si crees que es un error, responde al correo de tu compra y lo solucionamos."

#: pro/licensorpro-client/licensorpro-client.php:1904
msgid "Could not reach the licensing server. Your site may be blocking outbound requests. This is usually temporary, so try again in a minute."
msgstr "No se pudo conectar con el servidor de licencias. Puede que tu sitio bloquee las conexiones salientes. Suele ser temporal, así que vuelve a intentarlo en un minuto."

#: pro/licensorpro-client/licensorpro-client.php:1905
msgid "Too many attempts in a short window. Wait a minute and try again."
msgstr "Demasiados intentos en poco tiempo. Espera un minuto y vuelve a intentarlo."

#: pro/licensorpro-client/licensorpro-client.php:1906
msgid "The licensing server had a problem on its side. Your key was not rejected. Try again in a few minutes, and if it keeps happening, reply to your purchase email."
msgstr "El servidor de licencias tuvo un problema por su parte. Tu clave no se ha rechazado. Vuelve a intentarlo en unos minutos y, si sigue pasando, responde al correo de tu compra."

#: pro/licensorpro-client/licensorpro-client.php:1907
msgid "Enter your license key first."
msgstr "Primero introduce tu clave de licencia."

#: pro/licensorpro-client/licensorpro-client.php:1908
msgid "Installing Pro. This takes a few seconds, keep this page open…"
msgstr "Instalando Pro. Tarda unos segundos, mantén esta página abierta…"

#: pro/licensorpro-client/licensorpro-client.php:1909
msgid "Reloading to switch on the Pro tools…"
msgstr "Recargando para activar las herramientas Pro…"

#: pro/licensorpro-client/licensorpro-client.php:1910
msgid "Reload now"
msgstr "Recargar ahora"

#: pro/licensorpro-client/licensorpro-client.php:1911
msgid "Could not reach the licensing server. Check your connection and try again."
msgstr "No se pudo conectar con el servidor de licencias. Comprueba tu conexión y vuelve a intentarlo."

#: pro/licensorpro-client/licensorpro-client.php:1912
msgid "Deactivate this license on this site? Premium features switch off here and the seat is freed for another site."
msgstr "¿Desactivar esta licencia en este sitio? Las funciones premium se apagan aquí y el hueco queda libre para otro sitio."

#: pro/licensorpro-client/licensorpro-client.php:1913
msgid "Done."
msgstr "Hecho."

#: pro/licensorpro-client/licensorpro-client.php:1914
msgid "Deactivated."
msgstr "Desactivado."

#: pro/licensorpro-client/licensorpro-client.php:1915
msgid "Checked."
msgstr "Comprobado."

#: pro/licensorpro-client/licensorpro-client.php:2103
msgid "Only someone who may install plugins on this site can install Pro."
msgstr "Solo alguien que pueda instalar plugins en este sitio puede instalar Pro."

#: pro/licensorpro-client/licensorpro-client.php:2116
msgid "That is a free license key, so it keeps this free version updated. Pro needs the key from your purchase email."
msgstr "Esa es una clave de licencia gratuita, así que mantiene actualizada esta versión gratuita. Pro necesita la clave del correo de tu compra."

#. translators: %s: URL of the customer account
#: pro/licensorpro-client/licensorpro-client.php:2121
#, php-format
msgid "Your key is active. Download the Pro zip from your account (%s) and upload it over this plugin instead."
msgstr "Tu clave está activa. Descarga el zip de Pro desde tu cuenta (%s) y súbelo sobre este plugin."

#: pro/licensorpro-client/licensorpro-client.php:2125
msgid "This site does not allow installing plugins from the dashboard."
msgstr "Este sitio no permite instalar plugins desde el escritorio."

#: pro/licensorpro-client/licensorpro-client.php:2129
msgid "The Pro download could not be fetched for this key."
msgstr "No se pudo obtener la descarga de Pro para esta clave."

#: pro/licensorpro-client/licensorpro-client.php:2137
msgid "This site asks for FTP details to install plugins."
msgstr "Este sitio pide datos de FTP para instalar plugins."

#: pro/licensorpro-client/licensorpro-client.php:2172
msgid "Installing Pro did not finish."
msgstr "La instalación de Pro no terminó."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:2177
#, php-format
msgid "%s Pro is installed and your license is active. Reloading…"
msgstr "%s Pro está instalado y tu licencia está activa. Recargando…"

#: pro/licensorpro-client/licensorpro-client.php:2187
msgid "License activated."
msgstr "Licencia activada."

#: pro/licensorpro-client/licensorpro-client.php:2202
msgid "Site deactivated."
msgstr "Sitio desactivado."

#: pro/licensorpro-client/licensorpro-client.php:2213
msgid "License is valid. Update info refreshed."
msgstr "La licencia es válida. Información de actualizaciones renovada."

#: pro/licensorpro-client/licensorpro-client.php:2220
msgid "Permission denied."
msgstr "Permiso denegado."

