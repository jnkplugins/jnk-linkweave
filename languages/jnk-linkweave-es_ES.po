#: editor/src/InboundOpportunities.jsx:19
msgid "Drafts are not indexed yet. Once this post is published, related posts that should link here show up within a minute or so."
msgstr "Los borradores aún no se indexan. Cuando se publique esta entrada, las entradas relacionadas que deberían enlazar aquí aparecerán en un minuto más o menos."

#: editor/src/InboundOpportunities.jsx:24
msgid "This post has not been indexed yet. It is normally picked up within a minute of saving; this list refreshes on its own."
msgstr "Esta entrada aún no se ha indexado. Normalmente se procesa en menos de un minuto tras guardarla; esta lista se actualiza sola."

#: editor/src/InboundOpportunities.jsx:29
msgid "This post is too short to index, so no related posts can be found for it."
msgstr "Esta entrada es demasiado corta para indexarla, así que no se pueden encontrar entradas relacionadas."

#: editor/src/InboundOpportunities.jsx:34
msgid "This post type is not being indexed (see Post types in Settings)."
msgstr "Este tipo de contenido no se está indexando (consulta Tipos de contenido en los ajustes)."

#: editor/src/InboundOpportunities.jsx:39
msgid "The index has not been built yet (JnK Linkweave → Dashboard → Rebuild index)."
msgstr "El índice aún no se ha creado (JnK Linkweave → Escritorio → Reconstruir índice)."

#: editor/src/InboundOpportunities.jsx:44
msgid "No inbound opportunities found yet: every closely related post already links here, or none is related closely enough."
msgstr "Aún no hay oportunidades de enlaces entrantes: todas las entradas muy relacionadas ya enlazan aquí, o ninguna está lo bastante relacionada."

