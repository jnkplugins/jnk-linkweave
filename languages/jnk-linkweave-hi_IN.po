#: pro/licensorpro-client/licensorpro-client.php:750
msgid "Manage license"
msgstr "लाइसेंस प्रबंधित करें"

#: pro/licensorpro-client/licensorpro-client.php:753
#: admin/class-admin.php:280
msgid "Renew license"
msgstr "लाइसेंस रिन्यू करें"

#: pro/licensorpro-client/licensorpro-client.php:754
#: admin/class-admin.php:279
msgid "Activate license"
msgstr "लाइसेंस सक्रिय करें"

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:781
#, php-format
msgid "<strong>%s Pro is on.</strong> Thank you! Every Pro tool is switched on for this site, and updates come to your dashboard."
msgstr "<strong>%s Pro चालू है।</strong> धन्यवाद! इस साइट पर हर Pro टूल चालू है, और अपडेट आपके डैशबोर्ड में आते हैं।"

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:830
#, php-format
msgid "<strong>%s Pro is installed, but no Pro license is active on this site.</strong> Enter your license key to switch on the Pro tools."
msgstr "<strong>%s Pro इंस्टॉल है, लेकिन इस साइट पर कोई Pro लाइसेंस सक्रिय नहीं है।</strong> Pro टूल चालू करने के लिए अपनी लाइसेंस Key डालें।"

#: pro/licensorpro-client/licensorpro-client.php:836
msgid "Enter license key"
msgstr "लाइसेंस Key डालें"

#: pro/licensorpro-client/licensorpro-client.php:839
msgid "Find your key in your account"
msgstr "अपनी Key अपने अकाउंट में देखें"

#: pro/licensorpro-client/licensorpro-client.php:865
msgid "Renew your license"
msgstr "अपना लाइसेंस रिन्यू करें"

#. translators: 1: plugin name, 2: expiry date, 3: lock date, 4: days left
#: pro/licensorpro-client/licensorpro-client.php:871
#, php-format
msgid "<strong>Your %1$s Pro license expired on %2$s.</strong> Pro keeps working as normal until %3$s (%4$d days left). Updates, including security fixes, and email support have stopped. After %3$s, everything you already set up keeps working and your visitors won't notice a thing, but the Pro tools in your dashboard will lock."
msgstr "<strong>आपका %1$s Pro लाइसेंस %2$s को समाप्त हो गया।</strong> Pro %3$s तक पहले की तरह काम करता रहेगा (%4$d दिन बाकी)। अपडेट, जिनमें सुरक्षा सुधार भी शामिल हैं, और ईमेल सहायता बंद हो गई है। %3$s के बाद, आपने जो कुछ सेट किया है वह काम करता रहेगा और आपके विज़िटर को कुछ पता नहीं चलेगा, लेकिन आपके डैशबोर्ड के Pro टूल लॉक हो जाएँगे।"

#. translators: 1: plugin name, 2: expiry date
#: pro/licensorpro-client/licensorpro-client.php:881
#, php-format
msgid "<strong>%1$s Pro tools are locked because your license expired on %2$s.</strong> Your site, and everything visitors see, still works. Renew to unlock the Pro tools and get updates, including security fixes, again."
msgstr "<strong>%1$s Pro टूल लॉक हैं क्योंकि आपका लाइसेंस %2$s को समाप्त हो गया।</strong> आपकी साइट, और विज़िटर को दिखने वाली हर चीज़, अब भी काम करती है। Pro टूल अनलॉक करने और फिर से अपडेट (सुरक्षा सुधार समेत) पाने के लिए रिन्यू करें।"

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:889
#, php-format
msgid "<strong>This site is no longer activated on your %s Pro license.</strong> The Pro tools in your dashboard are locked until you activate it again. Everything visitors see keeps working."
msgstr "<strong>यह साइट अब आपके %s Pro लाइसेंस पर सक्रिय नहीं है।</strong> जब तक आप इसे फिर से सक्रिय नहीं करते, आपके डैशबोर्ड के Pro टूल लॉक रहेंगे। विज़िटर को दिखने वाली हर चीज़ काम करती रहेगी।"

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:896
#, php-format
msgid "<strong>Your %s Pro license is no longer active.</strong> It was refunded or cancelled, so the Pro tools in your dashboard are locked and updates have stopped. Everything visitors see keeps working."
msgstr "<strong>आपका %s Pro लाइसेंस अब सक्रिय नहीं है।</strong> इसका पैसा लौटाया गया या इसे रद्द किया गया, इसलिए आपके डैशबोर्ड के Pro टूल लॉक हैं और अपडेट बंद हो गए हैं। विज़िटर को दिखने वाली हर चीज़ काम करती रहेगी।"

#: pro/licensorpro-client/licensorpro-client.php:998
msgid "Please enter a license key."
msgstr "कृपया लाइसेंस Key डालें।"

#: pro/licensorpro-client/licensorpro-client.php:1010
#: pro/licensorpro-client/licensorpro-client.php:1069
msgid "License response failed signature verification."
msgstr "लाइसेंस सर्वर के जवाब का सिग्नेचर सत्यापित नहीं हुआ।"

#: pro/licensorpro-client/licensorpro-client.php:1052
msgid "No license key set."
msgstr "कोई लाइसेंस Key सेट नहीं है।"

#: pro/licensorpro-client/licensorpro-client.php:1184
msgid "Only deactivating temporarily"
msgstr "बस कुछ समय के लिए बंद कर रहा/रही हूँ"

#: pro/licensorpro-client/licensorpro-client.php:1185
msgid "I could not work out how to use it"
msgstr "मुझे समझ नहीं आया कि इसे कैसे इस्तेमाल करें"

#: pro/licensorpro-client/licensorpro-client.php:1186
msgid "It is missing a feature I need"
msgstr "इसमें वह सुविधा नहीं है जो मुझे चाहिए"

#: pro/licensorpro-client/licensorpro-client.php:1187
msgid "It did not work"
msgstr "यह काम नहीं किया"

#: pro/licensorpro-client/licensorpro-client.php:1188
msgid "It broke something on my site"
msgstr "इससे मेरी साइट पर कुछ खराब हो गया"

#: pro/licensorpro-client/licensorpro-client.php:1189
msgid "I found a better plugin"
msgstr "मुझे इससे बेहतर प्लगइन मिल गया"

#: pro/licensorpro-client/licensorpro-client.php:1190
msgid "I no longer need it"
msgstr "अब मुझे इसकी ज़रूरत नहीं है"

#: pro/licensorpro-client/licensorpro-client.php:1191
msgid "Something else"
msgstr "कुछ और"

#. translators: %s: plugin name.
#: pro/licensorpro-client/licensorpro-client.php:1218
#, php-format
msgid "Before you turn %s off"
msgstr "%s बंद करने से पहले"

#: pro/licensorpro-client/licensorpro-client.php:1222
msgid "If you have a moment, what went wrong? It is the only way we hear about it."
msgstr "अगर आपके पास एक पल हो, तो बताएँ क्या गड़बड़ हुई? हमें इसके बारे में जानने का यही एकमात्र तरीका है।"

#: pro/licensorpro-client/licensorpro-client.php:1233
msgid "Anything else? (optional)"
msgstr "कुछ और? (वैकल्पिक)"

#: pro/licensorpro-client/licensorpro-client.php:1235
msgid "Sends your answer, the plugin version and your site address. Nothing else, and nothing from your site content."
msgstr "आपका जवाब, प्लगइन का वर्शन और आपकी साइट का पता भेजता है। इसके अलावा कुछ नहीं, और आपकी साइट की सामग्री से कुछ भी नहीं।"

#: pro/licensorpro-client/licensorpro-client.php:1239
msgid "Send and deactivate"
msgstr "भेजें और निष्क्रिय करें"

#: pro/licensorpro-client/licensorpro-client.php:1242
msgid "Skip and deactivate"
msgstr "छोड़ें और निष्क्रिय करें"

#: pro/licensorpro-client/licensorpro-client.php:1245
#: admin/assets/js/admin.js:510
msgid "Cancel"
msgstr "रद्द करें"

#: pro/licensorpro-client/licensorpro-client.php:1366
#: pro/licensorpro-client/licensorpro-client.php:1382
msgid "API URL not configured."
msgstr "API URL कॉन्फ़िगर नहीं है।"

#: pro/licensorpro-client/licensorpro-client.php:1401
msgid "Unexpected response from license server."
msgstr "लाइसेंस सर्वर से अनपेक्षित जवाब मिला।"

#. translators: %s: human-readable time difference, e.g. "3 months".
#: pro/licensorpro-client/licensorpro-client.php:1700
#: includes/class-dates.php:38
#, php-format
msgid "in %s"
msgstr "%s में"

#. translators: %s: human-readable time difference, e.g. "13 days".
#: pro/licensorpro-client/licensorpro-client.php:1701
#: includes/class-dates.php:48
#, php-format
msgid "%s ago"
msgstr "%s पहले"

#: pro/licensorpro-client/licensorpro-client.php:1726
#, php-format
msgid "%s License"
msgstr "%s लाइसेंस"

#: pro/licensorpro-client/licensorpro-client.php:1736
msgid "This site was deactivated, so its seat is free for another site. Enter the key again here to switch the Pro tools back on."
msgstr "इस साइट को निष्क्रिय कर दिया गया, इसलिए इसकी सीट किसी दूसरी साइट के लिए खाली है। Pro टूल फिर से चालू करने के लिए यहाँ Key दोबारा डालें।"

#: pro/licensorpro-client/licensorpro-client.php:1746
#: pro/licensorpro-client/licensorpro-client.php:1777
#: pro/licensorpro-client/licensorpro-client.php:1841
msgid "License key"
msgstr "लाइसेंस Key"

#: pro/licensorpro-client/licensorpro-client.php:1747
msgid "Type"
msgstr "प्रकार"

#: pro/licensorpro-client/licensorpro-client.php:1749
msgid "Free license: updates of the free version only. It does not switch on Pro."
msgstr "Free लाइसेंस: सिर्फ़ Free वर्शन के अपडेट। इससे Pro चालू नहीं होता।"

#: pro/licensorpro-client/licensorpro-client.php:1750
msgid "Free license: updates arrive in your dashboard like any other plugin."
msgstr "Free लाइसेंस: अपडेट किसी भी दूसरे प्लगइन की तरह आपके डैशबोर्ड में आते हैं।"

#: pro/licensorpro-client/licensorpro-client.php:1752
#: pro/licensorpro-client/licensorpro-client.php:1809
msgid "Last checked"
msgstr "पिछली जाँच"

#: pro/licensorpro-client/licensorpro-client.php:1756
#: pro/licensorpro-client/licensorpro-client.php:1815
msgid "Check for updates now"
msgstr "अभी अपडेट जाँचें"

#: pro/licensorpro-client/licensorpro-client.php:1759
msgid "Bought Pro?"
msgstr "Pro खरीदा है?"

#: pro/licensorpro-client/licensorpro-client.php:1760
msgid "Enter your Pro license key and Pro is installed over this version. Everything you set up stays."
msgstr "अपनी Pro लाइसेंस Key डालें और Pro इस वर्शन के ऊपर इंस्टॉल हो जाएगा। आपने जो कुछ सेट किया है, वह बना रहेगा।"

#: pro/licensorpro-client/licensorpro-client.php:1762
msgid "Pro license key"
msgstr "Pro लाइसेंस Key"

#: pro/licensorpro-client/licensorpro-client.php:1765
#: pro/licensorpro-client/licensorpro-client.php:1822
msgid "Install Pro now"
msgstr "अभी Pro इंस्टॉल करें"

#: pro/licensorpro-client/licensorpro-client.php:1767
msgid "Rather do it by hand? Download the Pro zip from your account and upload it over this plugin."
msgstr "खुद करना चाहते हैं? अपने अकाउंट से Pro zip डाउनलोड करें और इसे इस प्लगइन के ऊपर अपलोड करें।"

#: pro/licensorpro-client/licensorpro-client.php:1768
#: pro/licensorpro-client/licensorpro-client.php:1849
msgid "Go to your account"
msgstr "अपने अकाउंट पर जाएँ"

#: pro/licensorpro-client/licensorpro-client.php:1780
msgid "active"
msgstr "सक्रिय"

#. translators: %s: date the Pro tools lock
#: pro/licensorpro-client/licensorpro-client.php:1782
#, php-format
msgid "expired, Pro tools stay on until %s"
msgstr "समाप्त, Pro टूल %s तक चालू रहेंगे"

#: pro/licensorpro-client/licensorpro-client.php:1783
msgid "expired, Pro tools locked"
msgstr "समाप्त, Pro टूल लॉक हैं"

#: pro/licensorpro-client/licensorpro-client.php:1785
msgid "this site is not activated"
msgstr "यह साइट सक्रिय नहीं है"

#: pro/licensorpro-client/licensorpro-client.php:1786
msgid "no longer active (refunded or cancelled)"
msgstr "अब सक्रिय नहीं (पैसा लौटाया गया या रद्द)"

#: pro/licensorpro-client/licensorpro-client.php:1788
#: admin/assets/js/admin.js:449
#: admin/assets/js/admin.js:918
msgid "Status"
msgstr "स्थिति"

#: pro/licensorpro-client/licensorpro-client.php:1790
msgid "Renew"
msgstr "रिन्यू करें"

#: pro/licensorpro-client/licensorpro-client.php:1794
msgid "Offline mode"
msgstr "ऑफ़लाइन मोड"

#: pro/licensorpro-client/licensorpro-client.php:1796
#, php-format
msgid "cached license valid until %s"
msgstr "कैश किया गया लाइसेंस %s तक मान्य"

#: pro/licensorpro-client/licensorpro-client.php:1801
msgctxt "update channel"
msgid "stable"
msgstr "स्टेबल"

#: pro/licensorpro-client/licensorpro-client.php:1802
msgctxt "update channel"
msgid "beta"
msgstr "बीटा"

#: pro/licensorpro-client/licensorpro-client.php:1803
msgctxt "update channel"
msgid "release candidate"
msgstr "रिलीज़ कैंडिडेट"

#: pro/licensorpro-client/licensorpro-client.php:1804
msgctxt "update channel"
msgid "development"
msgstr "डेवलपमेंट"

#: pro/licensorpro-client/licensorpro-client.php:1806
msgid "Update channel"
msgstr "अपडेट चैनल"

#: pro/licensorpro-client/licensorpro-client.php:1807
msgid "Site limit"
msgstr "साइट सीमा"

#: pro/licensorpro-client/licensorpro-client.php:1823
msgid "Unlimited"
msgstr "असीमित"

#: pro/licensorpro-client/licensorpro-client.php:1808
msgid "Expires"
msgstr "समाप्त होता है"

#: pro/licensorpro-client/licensorpro-client.php:1808
msgid "Never"
msgstr "कभी नहीं"

#: pro/licensorpro-client/licensorpro-client.php:1813
msgid "Deactivate this site"
msgstr "इस साइट को निष्क्रिय करें"

#: pro/licensorpro-client/licensorpro-client.php:1820
msgid "This is the free version, running on your Pro license."
msgstr "यह Free वर्शन है, जो आपके Pro लाइसेंस पर चल रहा है।"

#: pro/licensorpro-client/licensorpro-client.php:1837
msgid "Have a Pro license key? Enter it here to switch on the Pro tools. It replaces the free license on this site."
msgstr "क्या आपके पास Pro लाइसेंस Key है? Pro टूल चालू करने के लिए उसे यहाँ डालें। यह इस साइट के Free लाइसेंस की जगह ले लेगी।"

#: pro/licensorpro-client/licensorpro-client.php:1838
msgid "Enter your license key to activate this site."
msgstr "इस साइट को सक्रिय करने के लिए अपनी लाइसेंस Key डालें।"

#: pro/licensorpro-client/licensorpro-client.php:1845
msgid "Activate"
msgstr "सक्रिय करें"

#: pro/licensorpro-client/licensorpro-client.php:1848
msgid "Your key is in your purchase email and in your account."
msgstr "आपकी Key आपके खरीद वाले ईमेल में और आपके अकाउंट में है।"

#: pro/licensorpro-client/licensorpro-client.php:1856
msgid "Need a hand?"
msgstr "मदद चाहिए?"

#: pro/licensorpro-client/licensorpro-client.php:1857
msgid "Contact support"
msgstr "सहायता से संपर्क करें"

#: pro/licensorpro-client/licensorpro-client.php:1880
msgid "Every seat on this license is in use. Deactivate one of your other sites from your account, then try again."
msgstr "इस लाइसेंस की सभी साइटें इस्तेमाल में हैं। अपने अकाउंट से कोई दूसरी साइट निष्क्रिय करें, फिर दोबारा कोशिश करें।"

#: pro/licensorpro-client/licensorpro-client.php:1881
msgid "This license has expired. Renewing it from your account reactivates this site immediately. Your settings and data are untouched."
msgstr "इस लाइसेंस की अवधि खत्म हो गई है। अपने अकाउंट से रिन्यू करते ही यह साइट फिर से सक्रिय हो जाएगी। आपकी सेटिंग्स और डेटा जैसे हैं वैसे रहेंगे।"

#: pro/licensorpro-client/licensorpro-client.php:1882
msgid "That key was not recognised. Check for a missing character, or copy it again from your purchase email."
msgstr "यह Key पहचानी नहीं गई। देखें कि कोई अक्षर छूटा तो नहीं, या खरीद वाले ईमेल से इसे फिर से कॉपी करें।"

#: pro/licensorpro-client/licensorpro-client.php:1883
msgid "This key has been revoked. If you believe that is a mistake, reply to your purchase email and we will sort it out."
msgstr "यह Key रद्द कर दी गई है। अगर आपको लगता है कि यह गलती है, तो खरीद वाले ईमेल का जवाब दें, हम इसे ठीक कर देंगे।"

#: pro/licensorpro-client/licensorpro-client.php:1884
msgid "Could not reach the licensing server. Your site may be blocking outbound requests. This is usually temporary, so try again in a minute."
msgstr "लाइसेंस सर्वर तक नहीं पहुँच सके। हो सकता है आपकी साइट बाहर जाने वाले अनुरोध रोक रही हो। यह अक्सर कुछ देर के लिए होता है, इसलिए एक मिनट बाद फिर कोशिश करें।"

#: pro/licensorpro-client/licensorpro-client.php:1885
msgid "Too many attempts in a short window. Wait a minute and try again."
msgstr "थोड़े समय में बहुत ज़्यादा कोशिशें हो गईं। एक मिनट रुकें और फिर कोशिश करें।"

#: pro/licensorpro-client/licensorpro-client.php:1886
msgid "The licensing server had a problem on its side. Your key was not rejected. Try again in a few minutes, and if it keeps happening, reply to your purchase email."
msgstr "लाइसेंस सर्वर की तरफ से कोई दिक्कत आई। आपकी Key अस्वीकार नहीं हुई है। कुछ मिनट बाद फिर कोशिश करें, और अगर यह बार-बार हो तो खरीद वाले ईमेल का जवाब दें।"

#: pro/licensorpro-client/licensorpro-client.php:1887
msgid "Enter your license key first."
msgstr "पहले अपनी लाइसेंस Key डालें।"

#: pro/licensorpro-client/licensorpro-client.php:1888
