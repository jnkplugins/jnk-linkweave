{"translation-revision-date":"2026-10-10 16:38+0000","generator":"WP-CLI\/2.12.0","source":"editor\/build-elementor\/index.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ko_KR","plural-forms":"nplurals=1; plural=0;"},"Copy link":["\ub9c1\ud06c \ubcf5\uc0ac"],"Copied":["\ubcf5\uc0ac\ub428"],"Could not load link ideas.":["\ub9c1\ud06c \uc544\uc774\ub514\uc5b4\ub97c \ubd88\ub7ec\uc624\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4."],"Insert link":["\ub9c1\ud06c \uc0bd\uc785"],"This page already links here.":["\uc774 \ud398\uc774\uc9c0\ub294 \uc774\ubbf8 \uc5ec\uae30\ub85c \ub9c1\ud06c\ud569\ub2c8\ub2e4."],"No link ideas for this page yet. Linkweave reads it again after you publish or update it.":["\uc774 \ud398\uc774\uc9c0\uc5d0 \ub300\ud55c \ub9c1\ud06c \uc544\uc774\ub514\uc5b4\uac00 \uc544\uc9c1 \uc5c6\uc2b5\ub2c8\ub2e4. \ubc1c\ud589\ud558\uac70\ub098 \uc5c5\ub370\uc774\ud2b8\ud558\uba74 Linkweave\uac00 \ub2e4\uc2dc \uc77d\uc2b5\ub2c8\ub2e4."],"Insert link puts the link on matching words in the page text: Text Editor and Paragraph widgets, tabs, accordions and toggles. Nothing is saved until you click Publish or Update.":["\ub9c1\ud06c \uc0bd\uc785\uc740 \ud398\uc774\uc9c0 \ud14d\uc2a4\ud2b8(\ud14d\uc2a4\ud2b8 \ud3b8\uc9d1\uae30\u00b7\ubb38\ub2e8 \uc704\uc82f, \ud0ed, \uc544\ucf54\ub514\uc5b8, \ud1a0\uae00)\uc5d0\uc11c \uc77c\uce58\ud558\ub294 \ub2e8\uc5b4\uc5d0 \ub9c1\ud06c\ub97c \uac81\ub2c8\ub2e4. \uac8c\uc2dc \ub610\ub294 \uc5c5\ub370\uc774\ud2b8\ub97c \ub204\ub974\uae30 \uc804\uc5d0\ub294 \uc544\ubb34\uac83\ub3c4 \uc800\uc7a5\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."],"Select words in a Text Editor widget, click its link button and paste. Or paste into a button's Link field.":["\ud14d\uc2a4\ud2b8 \ud3b8\uc9d1\uae30 \uc704\uc82f\uc5d0\uc11c \ub2e8\uc5b4\ub97c \uc120\ud0dd\ud558\uace0 \ub9c1\ud06c \ubc84\ud2bc\uc744 \ub204\ub978 \ub4a4 \ubd99\uc5ec \ub123\uc73c\uc138\uc694. \ubc84\ud2bc\uc758 \ub9c1\ud06c \uce78\uc5d0 \ubd99\uc5ec \ub123\uc5b4\ub3c4 \ub429\ub2c8\ub2e4."],"This page has no Text Editor, Paragraph, tab, accordion or toggle text to put a link in. Use Copy link and paste it into a button's Link field.":["\uc774 \ud398\uc774\uc9c0\uc5d0\ub294 \ub9c1\ud06c\ub97c \ub123\uc744 \ud14d\uc2a4\ud2b8 \ud3b8\uc9d1\uae30, \ubb38\ub2e8, \ud0ed, \uc544\ucf54\ub514\uc5b8, \ud1a0\uae00 \ud14d\uc2a4\ud2b8\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. \ub9c1\ud06c \ubcf5\uc0ac\ub97c \uc0ac\uc6a9\ud574 \ubc84\ud2bc\uc758 \ub9c1\ud06c \uce78\uc5d0 \ubd99\uc5ec \ub123\uc73c\uc138\uc694."],"The page text has no words from this title outside headings and links. Use Copy link and add the link by hand.":["\uc81c\ubaa9\uacfc \ub9c1\ud06c\ub97c \uc81c\uc678\ud55c \ud398\uc774\uc9c0 \ud14d\uc2a4\ud2b8\uc5d0 \uc774 \uc81c\ubaa9\uc758 \ub2e8\uc5b4\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. \ub9c1\ud06c \ubcf5\uc0ac\ub97c \uc0ac\uc6a9\ud574 \uc9c1\uc811 \ub9c1\ud06c\ub97c \ucd94\uac00\ud558\uc138\uc694."],"Linkweave looked for %s and similar words in the page text, outside headings and links, and found none. Use Copy link, then select your own words in a Text Editor widget, click its link button and paste.":["Linkweave\uac00 \uc81c\ubaa9\uacfc \ub9c1\ud06c\ub97c \uc81c\uc678\ud55c \ud398\uc774\uc9c0 \ud14d\uc2a4\ud2b8\uc5d0\uc11c %s \ubc0f \ube44\uc2b7\ud55c \ub2e8\uc5b4\ub97c \ucc3e\uc558\uc9c0\ub9cc \uc5c6\uc5c8\uc2b5\ub2c8\ub2e4. \ub9c1\ud06c \ubcf5\uc0ac\ub97c \ub204\ub978 \ub4a4, \ud14d\uc2a4\ud2b8 \ud3b8\uc9d1\uae30 \uc704\uc82f\uc5d0\uc11c \uc6d0\ud558\ub294 \ub2e8\uc5b4\ub97c \uc120\ud0dd\ud558\uace0 \ub9c1\ud06c \ubc84\ud2bc\uc744 \ub20c\ub7ec \ubd99\uc5ec \ub123\uc73c\uc138\uc694."],"Linked \u201c%s\u201d. Click Publish or Update to save the page.":["\u201c%s\u201d\uc5d0 \ub9c1\ud06c\ud588\uc2b5\ub2c8\ub2e4. \ud398\uc774\uc9c0\ub97c \uc800\uc7a5\ud558\ub824\uba74 \uac8c\uc2dc \ub610\ub294 \uc5c5\ub370\uc774\ud2b8\ub97c \ub204\ub974\uc138\uc694."],"Elementor did not accept the change. Use Copy link instead.":["Elementor\uac00 \ubcc0\uacbd\uc744 \ubc1b\uc544\ub4e4\uc774\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \ub300\uc2e0 \ub9c1\ud06c \ubcf5\uc0ac\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."],"Copy this: %s":["\uc774 \uc8fc\uc18c\ub97c \ubcf5\uc0ac\ud558\uc138\uc694: %s"]}}}