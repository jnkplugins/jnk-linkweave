{"translation-revision-date":"2026-10-10 16:38+0000","generator":"WP-CLI\/2.12.0","source":"admin\/assets\/js\/linkmap.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ko_KR","plural-forms":"nplurals=1; plural=0;"},"No links in":["\ub4e4\uc5b4\uc624\ub294 \ub9c1\ud06c \uc5c6\uc74c"],"1 to 2 links":["\ub9c1\ud06c 1~2\uac1c"],"3 to 5 links":["\ub9c1\ud06c 3~5\uac1c"],"6 or more":["6\uac1c \uc774\uc0c1"],"Links to":["\uc5f0\uacb0 \ub300\uc0c1"],"%d post":["\uae00 %d\uac1c"],"%d link in":["\ub4e4\uc5b4\uc624\ub294 \ub9c1\ud06c %d\uac1c"],"%d link":["\ub9c1\ud06c %d\uac1c"],"%d with no links in":["\ub4e4\uc5b4\uc624\ub294 \ub9c1\ud06c\uac00 \uc5c6\ub294 \uae00 %d\uac1c"],"Nothing links here yet":["\uc544\uc9c1 \uc5ec\uae30\ub85c \ub9c1\ud06c\ud558\ub294 \uae00\uc774 \uc5c6\uc2b5\ub2c8\ub2e4"],"Read across a row: how many links that topic's posts send to each topic. The shaded diagonal is links inside the same topic. A row of empty cells is a topic that never links out.":["\uac01 \ud589\uc744 \uac00\ub85c\ub85c \uc77d\uc73c\uc138\uc694. \uadf8 \uc8fc\uc81c\uc758 \uae00\uc774 \uac01 \uc8fc\uc81c\ub85c \ubcf4\ub0b4\ub294 \ub9c1\ud06c \uc218\uc785\ub2c8\ub2e4. \uc74c\uc601 \ucc98\ub9ac\ub41c \ub300\uac01\uc120\uc740 \uac19\uc740 \uc8fc\uc81c \uc548\uc758 \ub9c1\ud06c\uc785\ub2c8\ub2e4. \ube48 \uce78\ub9cc \uc788\ub294 \ud589\uc740 \ubc16\uc73c\ub85c \ub9c1\ud06c\ud558\uc9c0 \uc54a\ub294 \uc8fc\uc81c\uc785\ub2c8\ub2e4."],"From \u2193":["\ubcf4\ub0b4\ub294 \ucabd \u2193"],"To \u2192":["\ubc1b\ub294 \ucabd \u2192"],"Total out":["\ub098\uac00\ub294 \ub9c1\ud06c \ud569\uacc4"],"None":["\uc5c6\uc74c"],"Which topics link to which. Topics that link to each other help readers move around your site.":["\uc5b4\ub5a4 \uc8fc\uc81c\uac00 \uc5b4\ub5a4 \uc8fc\uc81c\ub85c \ub9c1\ud06c\ud558\ub294\uc9c0 \ubcf4\uc5ec \uc90d\ub2c8\ub2e4. \uc11c\ub85c \ub9c1\ud06c\ud558\ub294 \uc8fc\uc81c\ub294 \ub3c5\uc790\uac00 \uc0ac\uc774\ud2b8\ub97c \ub458\ub7ec\ubcf4\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."],"Every dot is one post, grouped into islands by topic. Bigger dots have more links in, red dots have none. Drag to move, scroll or pinch to zoom, click a dot to see its links.":["\uc810 \ud558\ub098\uac00 \uae00 \ud558\ub098\uc774\uba70, \uc8fc\uc81c\ubcc4\ub85c \uc12c\ucc98\ub7fc \ubb36\uc5ec \uc788\uc2b5\ub2c8\ub2e4. \uc810\uc774 \ud074\uc218\ub85d \ub4e4\uc5b4\uc624\ub294 \ub9c1\ud06c\uac00 \ub9ce\uace0, \ube68\uac04 \uc810\uc740 \ub4e4\uc5b4\uc624\ub294 \ub9c1\ud06c\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. \ub04c\uc5b4\uc11c \uc774\ub3d9\ud558\uace0, \uc2a4\ud06c\ub864\ud558\uac70\ub098 \uc190\uac00\ub77d\uc744 \uc624\ubbc0\ub824 \ud655\ub300\/\ucd95\uc18c\ud558\uace0, \uc810\uc744 \ud074\ub9ad\ud558\uba74 \ub9c1\ud06c\ub97c \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4."],"Topic":["\uc8fc\uc81c"],"All topics":["\ubaa8\ub4e0 \uc8fc\uc81c"],"Post type":["\uae00 \uc720\ud615"],"All post types":["\ubaa8\ub4e0 \uae00 \uc720\ud615"],"Only posts with no links in":["\ub4e4\uc5b4\uc624\ub294 \ub9c1\ud06c\uac00 \uc5c6\ub294 \uae00\ub9cc"],"Find a post":["\uae00 \ucc3e\uae30"],"Zoom in":["\ud655\ub300"],"Zoom out":["\ucd95\uc18c"],"Fit":["\ub9de\ucda4"],"Link graph. Use the arrow keys to move, plus and minus to zoom.":["\ub9c1\ud06c \uadf8\ub798\ud504. \ud654\uc0b4\ud45c \ud0a4\ub85c \uc774\ub3d9\ud558\uace0 \ub354\ud558\uae30\/\ube7c\uae30 \ud0a4\ub85c \ud655\ub300\/\ucd95\uc18c\ud569\ub2c8\ub2e4."],"Click a dot to see which posts link to it and where it links.":["\uc810\uc744 \ud074\ub9ad\ud558\uba74 \uc5b4\ub5a4 \uae00\uc774 \uc774 \uae00\ub85c \ub9c1\ud06c\ud558\ub294\uc9c0, \uc774 \uae00\uc774 \uc5b4\ub514\ub85c \ub9c1\ud06c\ud558\ub294\uc9c0 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4."],"and %d more":["\uc678 %d\uac1c"],"Open post":["\uae00 \uc5f4\uae30"],"Edit post":["\uae00 \ud3b8\uc9d1"],"Linked from":["\ub9c1\ud06c\ud55c \uae00"],"Showing %1$s and %2$s.":["%1$s, %2$s \ud45c\uc2dc \uc911."],"No post with that title on the map.":["\uc9