#: editor/src/SuggestionList.jsx:271
#: editor/src/SuggestionList.jsx:302
msgid "Refresh"
msgstr "새로 고침"

#: editor/src/Sidebar.jsx:26
msgid "Suggested links"
msgstr "추천 링크"

#: editor/src/Sidebar.jsx:29
msgid "Posts that cover the same topic. Click into a paragraph, then insert a link."
msgstr "같은 주제를 다루는 글입니다. 문단을 클릭한 다음 링크를 삽입하세요."

#. translators: 1: plain-language strength, 2: raw relevance score.
#: editor/src/SuggestionItem.jsx:8
msgid "%1$s — relevance %2$s. Higher means more topic words in common."
msgstr "%1$s: 관련성 %2$s. 높을수록 공통 주제어가 많습니다."

#: editor/src/SuggestionItem.jsx:54
msgid "Insert link"
msgstr "링크 삽입"

#: editor/src/SuggestionList.jsx:51
msgid "Click into the paragraph you want the link in, then insert."
msgstr "링크를 넣을 문단을 클릭한 다음 삽입하세요."

#: editor/src/SuggestionList.jsx:75
msgid "That block cannot hold a link. Select a paragraph or list item and try again."
msgstr "이 블록에는 링크를 넣을 수 없습니다. 문단이나 목록 항목을 선택하고 다시 시도하세요."

#. translators: 1: indexable word count of this post, 2: configured minimum.
#: editor/src/SuggestionList.jsx:171
msgid "This post is too short to index, so it has no suggestions yet. It has %1$d indexable words and the minimum is %2$d — that is counted after common words like \"the\" and \"a\" are removed, so it is roughly half the visible word count."
msgstr "이 글은 색인하기에 너무 짧아서 아직 제안이 없습니다. 색인 가능한 단어가 %1$d개이고 최솟값은 %2$d개입니다. \"the\", \"a\" 같은 흔한 단어를 뺀 뒤 세므로, 보이는 단어 수의 대략 절반입니다."

#: editor/src/SuggestionList.jsx:180
msgid "Add a few more paragraphs, or lower the minimum in Settings."
msgstr "문단을 몇 개 더 추가하거나 설정에서 최솟값을 낮추세요."

#: editor/src/SuggestionList.jsx:190
#: editor/src/SuggestionList.jsx:210
msgid "Open settings"
msgstr "설정 열기"

#: editor/src/SuggestionList.jsx:200
msgid "This post type is not being indexed, so there is nothing to suggest here. You can add it under Post types in Settings."
msgstr "이 글 유형은 색인되지 않아서 여기에 제안할 것이 없습니다. 설정의 글 유형에서 추가할 수 있습니다."

#: editor/src/SuggestionList.jsx:220
msgid "No related posts cleared the relevance threshold for this one. That usually means it covers a topic nothing else on the site touches yet."
msgstr "이 글에 대해 관련성 기준을 넘은 관련 글이 없습니다. 보통 사이트의 다른 글이 아직 다루지 않은 주제라는 뜻입니다."

#: editor/src/SuggestionList.jsx:226
msgid "Lowering the minimum relevance score in Settings will surface weaker matches."
msgstr "설정에서 최소 관련성 점수를 낮추면 덜 비슷한 글도 나타납니다."

#: editor/src/SuggestionList.jsx:242
msgid "Suggestions appear once this post is published: drafts are not indexed yet. After publishing, this panel fills in within a minute or so."
msgstr "이 글이 발행되면 제안이 나타납니다. 임시글은 아직 색인되지 않습니다. 발행 후 1분 정도면 이 패널이 채워집니다."

#: editor/src/SuggestionList.jsx:258
msgid "This post has not been indexed yet. It is normally picked up within a minute of saving; a rebuild will catch it immediately."
msgstr "이 글은 아직 색인되지 않았습니다. 보통 저장 후 1분 안에 처리되며, 색인을 다시 만들면 바로 반영됩니다."

#: editor/src/SuggestionList.jsx:268
msgid "Rebuild the index"
msgstr "색인 다시 만들기"

#: editor/src/SuggestionList.jsx:281
msgid "No suggestions yet. Linkweave ranks suggestions against an index of your existing posts, so that index has to be built once before it can suggest anything."
msgstr "아직 제안이 없습니다. Linkweave는 기존 글의 색인을 기준으로 제안 순위를 매기므로, 제안을 받으려면 먼저 색인을 한 번 만들어야 합니다."

#: editor/src/SuggestionList.jsx:292
msgid "Build the index"
msgstr "색인 만들기"

#: editor/src/SuggestionList.jsx:296
msgid "Already built it? Save this post, then refresh."
msgstr "이미 만드셨나요? 이 글을 저장한 다음 새로 고치세요."

#~ msgid "Let Claude, ChatGPT and other MCP apps read your orphan posts, link counts and suggestions. Needs WordPress 6.9 or newer."
#~ msgstr "Claude, ChatGPT 및 기타 MCP 앱이 고아 글, 링크 수, 제안을 읽을 수 있게 합니다. WordPress 6.9 이상이 필요합니다."

#~ msgid "Read only: orphan posts, link counts and link suggestions. Assistants never change your posts. Works with Claude, ChatGPT and other MCP apps through the free MCP Adapter plugin, and only for users who could see these reports anyway."
#~ msgstr "읽기 전용: 고아 글, 링크 수, 링크 제안. 어시스턴트는 글을 절대 바꾸지 않습니다. 무료 MCP Adapter 플러그인을 통해 Claude, ChatGPT 및 기타 MCP 앱에서 작동하며, 원래 이 보고서를 볼 수 있는 사용자만 쓸 수 있습니다."

#~ msgid "This is JnK Linkweave Pro, but no licence is active on this site, so the Pro features are switched off: the URL Changer, link click analytics, Search Console targeting, the auto-link map, the Anchor Text report, broken-link repair, related posts, link preview cards, bulk link insertion, cross-site linking, AI re-ranking and the CSV exports."
#~ msgstr "JnK Linkweave Pro이지만 이 사이트에 활성 라이선스가 없어 Pro 기능이 꺼져 있습니다: URL 변경 도구, 링크 클릭 분석, Search Console 타기팅, 자동 링크 맵, 앵커 텍스트 보고서, 깨진 링크 복구, 관련 글, 링크 미리보기 카드, 링크 일괄 삽입, 사이트 간 링크, AI 재정렬, CSV 내보내기."

#, php-format
#~ msgid "Reading your posts: %1$d of %2$d (%3$s%%)"
#~ msgstr "글을 읽는 중: %2$d개 중 %1$d개(%3$s%%)"

#~ msgid "Cross-site linking (Agency)"
#~ msgstr "사이트 간 링크(Agency)"

#~ msgid "Suggest links between the sites on your license, right in the editor."
#~ msgstr "라이선스에 등록된 사이트끼리 링크를 편집기에서 바로 제안합니다."