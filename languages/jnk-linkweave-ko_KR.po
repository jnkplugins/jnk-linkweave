msgstr "JnK Linkweave 데이터베이스 테이블"

#: admin/class-admin.php:46
msgid "JnK Linkweave is missing database tables"
msgstr "JnK Linkweave에 데이터베이스 테이블이 없습니다"

#: admin/class-admin.php:49
msgid "Link suggestions and the reports cannot work without these tables. Send this list to support (jnkplugins.com/contact):"
msgstr "이 테이블이 없으면 링크 추천과 보고서가 작동하지 않습니다. 이 목록을 지원팀(jnkplugins.com/contact)에 보내 주세요:"

#: admin/class-admin.php:58
msgid "JnK Linkweave Pro data is ready"
msgstr "JnK Linkweave Pro 데이터가 준비되었습니다"

#: admin/class-admin.php:58
msgid "JnK Linkweave database tables are ready"
msgstr "JnK Linkweave 데이터베이스 테이블이 준비되었습니다"

#. translators: %d: number of database tables
#: admin/class-admin.php:63
#, php-format
msgid "The %d table JnK Linkweave needs is in the database."
msgid_plural "All %d tables JnK Linkweave needs are in the database."
msgstr[0] "JnK Linkweave에 필요한 테이블 %d개가 모두 데이터베이스에 있습니다."

#: admin/class-admin.php:87
msgid "JnK Linkweave could not create its database tables."
msgstr "JnK Linkweave가 데이터베이스 테이블을 만들지 못했습니다."

#: admin/class-admin.php:88
msgid "Link suggestions and the reports need them. Send the details below to support (jnkplugins.com/contact) and we will sort it out with you."
